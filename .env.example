# Copy this file to .env and fill in your own keys for local runs.
# .env is already listed in .gitignore -- never commit the real file.
# In GitHub Actions these are set as repository secrets instead (see
# README.md -> Automation), not read from .env.

# Concept-generation step (Claude Haiku). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Image-generation step (OpenAI Images API, gpt-image-1.5). Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
